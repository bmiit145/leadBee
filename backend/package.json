{
  "name": "@leadbee/backend",
  "version": "0.1.0",
  "private": true,
  "description": "LeadBee API — Fastify + Mongoose multi-tenant lead management",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/scripts/seed.ts",
    "seed:catalog": "tsx src/scripts/seedCatalog.ts",
    "sync-indexes": "tsx src/scripts/syncIndexes.ts",
    "init-rs": "tsx src/scripts/initReplicaSet.ts",
    "routes": "tsx src/scripts/routeTree.ts",
    "smoke": "tsx src/scripts/smokeTest.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/under-pressure": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "close-with-grace": "^2.5.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.3",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "nanoid": "^5.1.16",
    "otplib": "^12.0.1",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
