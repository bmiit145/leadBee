# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# A replica set (even a single-node one) is required for multi-document
# transactions, which organization provisioning uses. For local development:
#   mongod --dbpath <dir> --replSet rs0
#   npm run init-rs
MONGODB_URI=mongodb://127.0.0.1:27017/leadbee?replicaSet=rs0&directConnection=true
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# --- Localisation -----------------------------------------------------------
# ISO 3166-1 alpha-2 region a phone number typed without a country code is
# assumed to belong to. Which country LeadBee sells into is a business fact, so
# it lives here rather than inside the validator. Numbers from other countries
# are still accepted when written in full international form (+1 415 555 2671).
# The dashboard and mobile app pin the same value in their own phone helpers —
# change those too, or a form will accept what the API rejects.
DEFAULT_PHONE_REGION=IN

# --- Tenant auth realm (mobile app + tenant APIs) ---------------------------
JWT_SECRET=change-me-tenant-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-tenant-refresh-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Platform auth realm (superadmin control plane) -------------------------
# Deliberately different secrets: a tenant token must never address /platform.
PLATFORM_JWT_SECRET=change-me-platform-access-secret-at-least-32-chars
PLATFORM_JWT_REFRESH_SECRET=change-me-platform-refresh-secret-at-least-32-chars
PLATFORM_JWT_EXPIRES_IN=30m
PLATFORM_JWT_REFRESH_EXPIRES_IN=7d

# Bootstrap platform admin, created by `npm run seed`.
PLATFORM_BOOTSTRAP_EMAIL=owner@leadbee.io
PLATFORM_BOOTSTRAP_PASSWORD=ChangeMe!2024
PLATFORM_BOOTSTRAP_NAME=Platform Owner

# --- CORS -------------------------------------------------------------------
# Comma-separated. The dashboard and Expo dev server during development.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# --- Signup / plans ---------------------------------------------------------
ALLOW_SELF_SERVE_SIGNUP=true
TRIAL_DAYS=14

# --- Rate limits ------------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
