# --- API -------------------------------------------------------------------
# Origin of the LeadBee API: scheme and host only. No path, no trailing slash.
# The app appends /api/v1/platform itself.
#
#   production    https://api.example.com
#   staging       https://api.staging.example.com
#
# Leave it UNSET for local development. The Vite dev server proxies /api to
# http://localhost:4000, so the browser sees a same-origin request and neither
# CORS nor the backend's origin allowlist comes into play.
#
# Required for every production build — `vite build` fails without it rather
# than shipping a bundle that quietly requests the API from its own domain.
# VITE_API_ORIGIN=

# Backend the dev server proxies /api to. Only used by `npm run dev`.
# VITE_DEV_API_PROXY=http://localhost:4000
