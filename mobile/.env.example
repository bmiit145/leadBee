# The LeadBee API, including the version prefix.
#
# On Android the emulator reaches the host machine at 10.0.2.2, never
# localhost — the API client rewrites localhost/127.0.0.1 to 10.0.2.2
# automatically, so the value below works on both platforms.
#
# For a physical device on the same network, use the machine's LAN address:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_ENVIRONMENT=development
