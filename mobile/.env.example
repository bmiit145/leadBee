# This file configures LOCAL DEVELOPMENT ONLY.
#
# EAS builds do not read it. `EXPO_PUBLIC_*` values are inlined into the bundle
# at build time, and for builds they come from the EAS environment named by the
# build profile's `environment` key in eas.json (development / preview /
# production). See docs/DEPLOYMENT.md for the `eas env:create` commands.

# The LeadBee API, including the version prefix.
#
# Used exactly as written — set it to something the device can actually reach.
#
#   iOS simulator        http://localhost:4000/api/v1
#   Android emulator     http://10.0.2.2:4000/api/v1   (10.0.2.2 is the
#                        emulator's alias for the host; unroutable elsewhere)
#   Physical device      the machine's LAN address, e.g.
#                        http://192.168.1.20:4000/api/v1
#
# Leave it unset and the client picks the right simulator/emulator default.
# That fallback is development-only: a staging or production build with no
# EXPO_PUBLIC_API_URL throws at launch rather than shipping pointed at
# localhost.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# One of: development | staging | production.
# Drives log verbosity (src/utils/logger.ts) and the missing-URL guard above.
# Build profiles set this themselves in eas.json.
EXPO_PUBLIC_ENVIRONMENT=development
