{
  "expo": {
    "name": "LeadBee",
    "slug": "leadbee",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/leadbee-icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "leadbee",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spirit.leadbee",
      "infoPlist": {
        "CFBundleLocalizations": [
          "gu",
          "en"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#186F90"
      },
      "package": "com.spirit.leadbee",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-notifications",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "gu",
              "en"
            ],
            "android": [
              "gu",
              "en"
            ]
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c50a1543-6478-45e9-90d1-03ea970a0145"
      }
    },
    "owner": "leadbee"
  }
}
